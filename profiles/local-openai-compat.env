# profiles/local-openai-compat.env — the T330 profile contract's executable
# documentation (docs/install-profiles.md): a localhost placeholder profile
# for any LLM proxy / gateway that speaks the Anthropic Messages API.
#
# Company profiles NEVER live in the repo — copy this file to
# ~/.chug/profiles/<name>.env (private values stay on the box), fill in your
# proxy's real values, then:
#
#   install.sh --profile <name>
#
# The file exports EXACTLY the profile-owned keys; install.sh refuses
# anything else (and loopd silently skips unknown keys).

# Where the Messages API lives (required). A local proxy for development;
# in production this is your company LLM proxy's HTTPS endpoint.
export CHUG_LLM_BASE_URL="http://127.0.0.1:8080"

# Credentials — EXACTLY ONE of the two forms (install.sh refuses both):
#
# 1. The escape hatch (recommended): a command whose stdout is the key.
#    Evaluated once at supervisor startup; the value is never logged.
#    Replace with your secret store's one-liner, e.g.:
#      CHUG_LLM_API_KEY_CMD='vault kv get -field=token secret/chug/llm'
#      CHUG_LLM_API_KEY_CMD='op read "op://vault/chug-llm/token"'
export CHUG_LLM_API_KEY_CMD="printf %s sk-local-dev-REPLACE-ME"

# 2. The literal form (the file must then stay private, mode 600):
# export CHUG_LLM_API_KEY="sk-REPLACE-ME"

# The model pair (required) — FULL provider-routed ids, exactly what
# `--model` takes (no alias layer; values go verbatim into the request).
# The reasoning model drives fresh-eval / judgment cycles; the coding model
# drives routine queue-working cycles.
export CHUG_MODEL_REASONING="anthropic/REPLACE-WITH-YOUR-REASONING-MODEL"
export CHUG_MODEL_CODING="anthropic/REPLACE-WITH-YOUR-CODING-MODEL"

# Optional Langfuse tracing — all three or none (SPEC-8; off without them):
# export CHUG_LANGFUSE_HOST="http://127.0.0.1:3000"
# export CHUG_LANGFUSE_PUBLIC_KEY="pk-lf-REPLACE-ME"
# export CHUG_LANGFUSE_SECRET_KEY="sk-lf-REPLACE-ME"
