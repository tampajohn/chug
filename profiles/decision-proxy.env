# profiles/decision-proxy.env — the T332 decision-provider profile keys
# (docs/decision-providers.md): a full T330 profile that ALSO wires the
# decision layer to a hosted System One proxy, so a pilot box needs no local
# daemon. The local laya daemon stays the free/offline default — this
# profile is for operators whose decision calls should ride the proxy.
#
# Company profiles NEVER live in the repo — copy this file to
# ~/.chug/profiles/<name>.env (private values stay on the box), fill in your
# proxy's real values, then:
#
#   install.sh --profile <name>
#
# PLACEHOLDER VALUES ONLY below — never commit a real endpoint or token.

# --- the T330 LLM keys (required in every profile; see
# --- profiles/local-openai-compat.env for the annotated original) -----------
export CHUG_LLM_BASE_URL="http://127.0.0.1:8080"
export CHUG_LLM_API_KEY_CMD="printf %s sk-local-dev-REPLACE-ME"
export CHUG_MODEL_REASONING="anthropic/REPLACE-WITH-YOUR-REASONING-MODEL"
export CHUG_MODEL_CODING="anthropic/REPLACE-WITH-YOUR-CODING-MODEL"

# --- the T332 decision-provider keys (optional; pass-through) ----------------

# The selection key (optional; the default is `auto`): `auto` prefers a
# healthy local daemon and falls back to the proxy only when one is
# configured; `proxy` consults the proxy alone; `local` is the daemon only.
export CHUG_DECISION_PROVIDER="proxy"

# The proxy's base URL (required for proxy, and for auto's fallback): the
# loop posts to <base>/v1/systemone. Placeholder — replace with your proxy.
export CHUG_DECISION_PROXY_URL="http://127.0.0.1:8080"

# The proxy credential (recommended): sent as `Authorization: Bearer …`.
# The installed profile is mode 600; keep the real value in your private
# copy, never in the repo.
export CHUG_DECISION_PROXY_TOKEN="REPLACE-ME"
